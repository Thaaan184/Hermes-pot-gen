# AI Design Studio — Environment Variables
# Copy to .env and fill in secrets before running.

# ── Penpot Public URI (used by penpot-frontend and backend) ──────────────────
PENPOT_PUBLIC_URI=http://100.106.40.93:9001

# ── Penpot Version ────────────────────────────────────────────────────────────
PENPOT_VERSION=2.18

# ── Studio Service Account ────────────────────────────────────────────────────
# This account is pre-registered in Penpot Postgres.
# Used by studio-api to obtain a server-side session token.
PENPOT_SERVICE_USER=studio-service@nct.internal
PENPOT_SERVICE_PASS=StudioSecretPassword123!

# ── Studio Default Project ────────────────────────────────────────────────────
# The Penpot project where studio-api creates and lists canvas files.
PENPOT_DEFAULT_PROJECT_ID=5e8f6953-f7b8-8027-8008-c0ab390df7ef

# ── Service Account Profile IDs (informational, not consumed at runtime) ──────
# profile_id: 5e8f6953-f7b8-8027-8008-c0ab390d5c26
# default-team-id: 5e8f6953-f7b8-8027-8008-c0ab390db421
